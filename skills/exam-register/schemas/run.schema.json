{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "shared_material_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "set_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "browser": {
      "type": "object",
      "properties": {
        "preference": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "available",
            "unavailable"
          ]
        }
      },
      "required": [
        "preference",
        "actual",
        "status"
      ],
      "additionalProperties": false
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "question_id": {
            "type": "string",
            "minLength": 1
          },
          "step": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "intent",
              "succeeded",
              "failed",
              "uncertain"
            ]
          },
          "document_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "request": {
            "type": [
              "string",
              "null"
            ]
          },
          "response": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "question_id",
          "step",
          "status",
          "document_id",
          "evidence",
          "request",
          "response"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "timings_seconds": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "questions",
    "shared_material_ids",
    "set_id",
    "browser",
    "operations",
    "timings_seconds"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
